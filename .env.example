# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender Email Address
# Use "onboarding@resend.dev" for testing before domain verification.
# Once your domain is verified on Resend, change to e.g. "Glorious Eagles <notifications@gloriouseagles.com>"
EMAIL_FROM=onboarding@resend.dev

# Administrator / Notification Email Address
# Where intake forms, applications, and contact messages are sent
ADMIN_EMAIL=president@gloriouseagles.com
